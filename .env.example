# Platform API (new collaboration stack)
NODE_ENV=development
PLATFORM_PORT=3080
PLATFORM_PUBLIC_URL=http://localhost:3080
STORE_DRIVER=memory
# STORE_DRIVER=postgres
DATABASE_URL=postgres://realtime:realtime@localhost:5432/realtime
# Optional. Enables Socket.IO Redis fan-out, Redis presence, and Y.Doc cache invalidation.
# Leave unset for a single process. Horizontal scale also requires a shared STORE_DRIVER=postgres.
# REDIS_URL=redis://localhost:6379
SEED_DEMO=true
# Required in production. Used only to sign platform room tokens, never customer sk_ values.
PLATFORM_SIGNING_SEED=change-me-to-a-long-random-string
TOKEN_TTL_SECONDS=900
TOKEN_TTL_MIN_SECONDS=60
TOKEN_TTL_MAX_SECONDS=3600
REVOCATION_POLL_MS=2000
CORS_ORIGINS=http://localhost:4000

# Sample integrator (owns its own users)
SAMPLE_PORT=4000
SAMPLE_SESSION_SECRET=change-me-sample-session
REALTIME_API_URL=http://localhost:3080
REALTIME_SECRET_KEY=sk_test_sample_local_dev_only_rotate
NEXT_PUBLIC_REALTIME_PUBLIC_KEY=pk_test_sample_local_dev_only
NEXT_PUBLIC_REALTIME_URL=http://localhost:3080

# Optional self-hosted LiveKit. Leave unset to disable voice.
# Dev keys are LiveKit's --dev defaults. Do not use them in production.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# alice@example.com / alice-pass-1
# bob@example.com / bob-pass-1